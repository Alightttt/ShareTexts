[TEMPLATE]
# ShareText — signaling configuration
#
# The client picks a transport in this order:
#   1. VITE_SIGNALING_URL  → Cloudflare Workers (free-tier, preferred)
#   2. VITE_SOCKET_URL      → Node socket.io server (Render/Railway/self-host)
#   3. neither              → same-origin (dev / self-hosted server)
#
# ⚠️ BUILD-TIME ONLY: Vite inlines VITE_* values into the bundle at `vite build`
# time. On Vercel, add these in Project → Settings → Environment Variables with
# the "Production" scope enabled, then REDEPLOY. Adding the variable after a
# build and refreshing the page does NOT pick it up.

# Cloudflare Worker endpoint (no /ws suffix needed):
# VITE_SIGNALING_URL=https://sharetext-signaling.<subdomain>.workers.dev

# Node socket.io server endpoint (used when VITE_SIGNALING_URL is unset):
# VITE_SOCKET_URL=https://sharetext-signaling.onrender.com

# Worker-side var: comma-separated extra frontend origins allowed to connect.
# The Worker's allowlist already includes localhost dev + https://sharetexts.online.
# If your Vercel project URL is anything else (e.g. https://sharetext-abc.vercel.app
# or a custom domain), you MUST add it here and redeploy the Worker, or every
# browser will get "This browser isn't allowed to connect" / "Couldn't reach ShareText."
# ALLOWED_ORIGINS=https://sharetext-abc.vercel.app,https://share.example.com

[TEMPLATE]
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
