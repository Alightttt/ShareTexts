{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node -e \"process.env.NODE_ENV=process.env.NODE_ENV||'production';require('./dist/server.cjs')\"",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:test": "node scripts/verify-worker.mjs",
    "worker:test-live": "node scripts/verify-worker-live.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "otpauth": "^9.5.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.120.1"
  }
}
